# Copia este archivo como ".env" y cambia TODAS las contrasenas.
# No uses comillas ni el caracter ' dentro de las contrasenas.

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=CambiaEstaRoot_2026
MYSQL_DATABASE=banco
MYSQL_PORT=3307

# Usuario de la aplicacion (privilegios minimos)
APP_DB_USER=banco_app
APP_DB_PASSWORD=CambiaEstaApp_2026

# Usuario de solo lectura para reportes / analistas en Workbench
REPORT_DB_USER=banco_reportes
REPORT_DB_PASSWORD=CambiaEstaReportes_2026

# ---------- Neo4j ----------
# Minimo 8 caracteres
NEO4J_PASSWORD=CambiaEstaNeo4j_2026

# ---------- Claves del backend ----------
# Cada una es base64 de 32 bytes aleatorios. Generalas con:
#   python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Si se pierde CLAVE_CIFRADO, los datos cifrados (cedulas, celulares) no se pueden recuperar.
JWT_SECRETO=GENERA_UNA_CLAVE
CLAVE_CIFRADO=GENERA_UNA_CLAVE
CLAVE_INDICES=GENERA_UNA_CLAVE

# ---------- Simulador (Fase 3) ----------
SIM_DB_USER=banco_simulador
SIM_DB_PASSWORD=CambiaEstaSim_2026
# Contrasena compartida por TODOS los clientes simulados (solo datos de prueba)
SIM_PASSWORD_CLIENTES=CambiaEstaDemo2026

# ---------- General ----------
# Zona horaria (importa para la regla de "horario nocturno")
TZ=America/Bogota
